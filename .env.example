# Local development only. No external API keys are required.
WEB_PORT=3080
# Optional override for the isolated application database; never reuse a real password.
POSTGRES_PASSWORD=local-demo-only

# Optional compose.llm.yaml. Off in the default stack.
LLM_MODE=local
LLM_BASE_URL=http://host.docker.internal:11434/v1
LLM_MODEL=
LLM_API_KEY=
LLM_ALLOW_EXTERNAL=false
